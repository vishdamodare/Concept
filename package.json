{
  "name": "concept",
  "version": "1.0.0",
  "description": "AI-Powered Learning Platform",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run start --workspace=frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "cd backend && python3 -m uvicorn server:app --host 127.0.0.1 --port 5000 --reload",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "echo 'No build step for backend'",
    "start": "cd backend && python3 -m uvicorn server:app --host 127.0.0.1 --port 5000",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "CI=true npm run test --workspace=frontend",
    "test:backend": "cd backend && python3 -m pytest tests/",
    "test:coverage": "echo 'No coverage check configured'",
    "test:e2e": "echo 'No E2E tests configured'",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "cd backend && python3 -m flake8 server.py",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "npm run format --workspace=frontend",
    "format:backend": "cd backend && python3 -m black server.py",
    "type-check": "echo 'No TypeScript check needed (pure JS)'",
    "check": "npm run lint && npm run test",
    "clean": "npm run clean --workspace=frontend"
  },
  "workspaces": [
    "frontend"
  ],
  "keywords": [
    "AI",
    "Learning",
    "Education",
    "Tutoring",
    "Platform"
  ],
  "author": "vishdamodare",
  "license": "Proprietary",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
